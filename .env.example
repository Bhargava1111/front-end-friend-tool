# ── API ──────────────────────────────────────────────────────────────
# Client-side API base (browser). Use /api/v1 for Vite proxy in dev.
VITE_API_URL=/api/v1
# Server-side API base (TanStack server functions / SSR).
API_URL=http://127.0.0.1:8000/api/v1
# Vite dev proxy target for /api/v1 → Django.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ── App URLs ─────────────────────────────────────────────────────────
# Local dev web URL (used by mobile-config script).
VITE_APP_URL=http://localhost:8080
# Production web app URL.
VITE_PUBLIC_WEB_URL=https://front-end-friend-tool.lovable.app
# Capacitor WebView server URL (set before cap:sync for release builds).
CAPACITOR_SERVER_URL=https://front-end-friend-tool.lovable.app

# ── Media ────────────────────────────────────────────────────────────
# Optional CDN base for media URLs (leave empty to use API-relative paths).
VITE_MEDIA_BASE_URL=

# ── External services ────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_TRACKING_ID=
VITE_GEO_REVERSE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
VITE_GOOGLE_FONTS_URL=https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap
VITE_GOOGLE_FONTS_PRECONNECT=https://fonts.googleapis.com
VITE_GOOGLE_FONTS_STATIC_PRECONNECT=https://fonts.gstatic.com

# ── Support contact ──────────────────────────────────────────────────
VITE_SUPPORT_PHONE=9390872628
VITE_SUPPORT_EMAIL=care@srimahalakshmistores.in
VITE_WHATSAPP_BASE_URL=https://wa.me

# ── OTP timing ───────────────────────────────────────────────────────
VITE_OTP_TTL_SECONDS=300
VITE_OTP_RESEND_COOLDOWN=30
