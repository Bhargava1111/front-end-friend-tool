# Production environment — copy to /var/www/mnxstore/.env
# NEVER commit the real .env file to Git.

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_import_secrets_print_secrets_token_urlsafe_50
DEBUG=False

# VPS IP and your domain(s) — comma-separated, no spaces
ALLOWED_HOSTS=200.234.39.88,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN,http://200.234.39.88

# Frontend URLs allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN,http://200.234.39.88,http://localhost,https://localhost,capacitor://localhost,ionic://localhost
CORS_ALLOW_ALL_ORIGINS=False

# PostgreSQL (local on VPS — created by install.sh)
DATABASE_URL=postgresql://mnxstore:CHANGE_DB_PASSWORD@127.0.0.1:5432/mnxstore
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=600

# Public URLs (update after SSL)
PUBLIC_API_URL=http://200.234.39.88
MEDIA_PUBLIC_BASE_URL=http://200.234.39.88/media

ENABLE_DEMO_OTP=True
ALLOW_DEMO_SEED=1

# HTTPS behind Nginx (enable SECURE_SSL_REDIRECT after Certbot)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Redis / Celery (background: OTP, email, SMS, push)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# Web push (optional — generate: npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:care@srimahalakshmistores.in

# Email (production OTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=care@srimahalakshmistores.in
