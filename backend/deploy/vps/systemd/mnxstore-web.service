[Unit]
Description=Sri Mahalakshmi Stores Web Frontend (Nitro/Node)
After=network.target mnxstore-api.service
Wants=mnxstore-api.service

[Service]
Type=simple
User=mnxstore
Group=www-data
WorkingDirectory=/var/www/mnxstore/web-output
EnvironmentFile=/var/www/mnxstore/.env
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=NITRO_PORT=3000
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
