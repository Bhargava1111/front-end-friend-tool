# Production — copy to .env on the server (never commit real secrets).

DJANGO_SECRET_KEY=generate-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com,200.234.39.88
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://front-end-friend-tool.lovable.app
CORS_ALLOW_ALL_ORIGINS=False

# PostgreSQL (required when DEBUG=False)
DATABASE_URL=postgresql://mnx:STRONG_PASSWORD@db-host:5432/mnxstore
POSTGRES_SSLMODE=require
DB_CONN_MAX_AGE=600

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

PUBLIC_API_URL=https://api.yourdomain.com
MEDIA_PUBLIC_BASE_URL=https://api.yourdomain.com/media

ENABLE_DEMO_OTP=False

# Email (production OTP / notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# HTTPS behind reverse proxy (nginx / Azure / Railway)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
