DJANGO_SECRET_KEY=dev-secret-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ENABLE_DEMO_OTP=True
ADMIN_PANEL_IDLE_SECONDS=600

# ── PostgreSQL (recommended — production-ready) ─────────────────────
# Start local Postgres:  docker compose up -d   (from backend/)
DATABASE_URL=postgresql://mnx:mnx_dev_password@127.0.0.1:5433/mnxstore

# Or set individual vars instead of DATABASE_URL:
# POSTGRES_DB=mnxstore
# POSTGRES_USER=mnx
# POSTGRES_PASSWORD=mnx_dev_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional PostgreSQL tuning
# POSTGRES_SSLMODE=prefer          # use "require" in production
# DB_CONN_MAX_AGE=600              # connection pooling (seconds)
# DB_ATOMIC_REQUESTS=false

# Redis / Celery (local dev — optional; eager mode runs tasks inline)
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=True

# Fallback to SQLite only when DATABASE_URL is unset and DEBUG=True
# USE_SQLITE=true

# Public URLs (used for media links, CORS, etc.)
PUBLIC_API_URL=http://127.0.0.1:8000
MEDIA_PUBLIC_BASE_URL=

# Web push notifications (browser / PWA)
# Generate: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:care@srimahalakshmistores.in

# Live Supabase clone (optional — for clone_supabase_catalog command)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
